# NGINX reverse proxy entrypoint for ft_transcendence
# Requests are filtered by ModSecurity + OWASP CRS before being proxied.

server_tokens ${SERVER_TOKENS};

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Basic anti-abuse controls
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=frontend_limit:10m rate=60r/s;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};
    client_max_body_size 10m;
    limit_conn conn_limit 50;
    limit_req_status 429;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;

    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;

    set $api_upstream http://api-gateway:8000;
    set $frontend_upstream http://frontend:5173;

    # Public health endpoint for container checks
    location /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK";
    }

    # API traffic -> FastAPI gateway
    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;

        limit_except GET POST PUT PATCH DELETE OPTIONS {
            deny all;
        }

        proxy_set_header Host $host;
        proxy_set_header Proxy "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 36000s;
        proxy_redirect off;

        proxy_pass $api_upstream;
    }

    # Frontend traffic -> React/Vite container
    location / {
        limit_req zone=frontend_limit burst=100 nodelay;

        limit_except GET HEAD OPTIONS {
            deny all;
        }

        proxy_set_header Host $host;
        proxy_set_header Proxy "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 36000s;
        proxy_redirect off;

        proxy_pass $frontend_upstream;
    }

    # Block hidden files (except ACME)
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }
}
