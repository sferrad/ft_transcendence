# =================================================================
# FICHIER .env.example
# 
# Ce fichier montre quelles variables doivent être définies
# Les valeurs ici sont des EXEMPLES, pas les vraies valeurs
# 
# Pour l'utiliser :
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplacez les valeurs par les vraies
# =================================================================


# Base de données
POSTGRES_DB=votre_nom_de_base
POSTGRES_USER=votre_utilisateur
POSTGRES_PASSWORD=votre_mot_de_passe_fort
DB_PORT=5432
# Détails :
# - postgresql:// → Type de base de données
# - user → Doit correspondre à POSTGRES_USER
# - password → Doit correspondre à POSTGRES_PASSWORD
# - db → Nom du conteneur Docker (défini dans docker-compose.yml)
# - 5432 → Port par défaut de PostgreSQL
# - dbname → Doit correspondre à POSTGRES_DB

# Vault
VAULT_ADDR=http://vault.votre-domaine.com:8200
VAULT_DB_SSLMODE=enable or disable ssl
JWT_SECRET_KEY=random-secret-keyJWT_ALGORITHM=HS256(openssl rand -hex 32)


# Frontend
# URL de l'API backend
REACT_APP_API_URL=http://localhost/api
# URL du WebSocket (pour les communications temps réel)
REACT_APP_WS_URL=ws://localhost/ws